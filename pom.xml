<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ebsolutions.applications.whoami</groupId>
    <artifactId>who-am-i-database</artifactId>
    <version>${revision}</version>
    <name>Who Am I Database</name>
    <packaging>jar</packaging>

    <properties>
        <!-- This value will be overridden by the injected value in CI -->
        <revision>0.0.0-SNAPSHOT</revision>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub aaronsisler Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/aaronsisler/applications.who-am-i.database</url>
        </repository>
    </distributionManagement>
</project>
